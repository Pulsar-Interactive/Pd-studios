#X obj 260 150 sel 0;
#X obj 700 150 expr min(12000 \, max(1200 \, 9000*pow(0.5 \, (\$f1-36)/24)));
#X obj 700 120 f;
#X obj 260 190 t f b;
#X msg 700 190 0 \, 1 3 \, 0 \$1 3;
#X obj 850 190 * 0.22;
#X msg 850 220 0 \, 1 3 \, 0 \$1 3;
#X msg 260 230 0 600;
#X obj 1000 260 noise~;
#X obj 1000 290 bp~ 3000 1;
