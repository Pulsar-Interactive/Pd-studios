#N canvas 40 40 1300 760 12;
#X text 20 5 [grand-voice] - synthesized piano voice for [clone] \, same inlet as piano-voice (pitch velocity \, 0 = release). 6 slightly stretched partials (string inharmonicity) \, the lowest 3 doubled with a second string 1.5 cents sharp for the beating of a real piano \, a slow envelope on partials 1-2 and a fast one on 3-6 (bright overtones die first) \, low notes ring up to 12 s and high notes shorter \, a 30 ms hammer noise \, velocity makes it louder and brighter. release = 600 ms fade \, standing in for the sustain pedal;
#X obj 20 60 inlet;
#X obj 20 90 unpack f f;
#X obj 260 120 f;
#X obj 20 120 t b f;
#X obj 100 150 mtof;
#X obj 100 180 expr \$f1*sqrt(1+0.0004) \; \$f1*2*sqrt(1+0.0004*4) \; \$f1*3*sqrt(1+0.0004*9) \; \$f1*4*sqrt(1+0.0004*16) \; \$f1*5*sqrt(1+0.0004*25) \; \$f1*6*sqrt(1+0.0004*36) \; \$f1*1.000867*sqrt(1+0.0004) \; \$f1*2.001734*sqrt(1+0.0004*4) \; \$f1*3.002601*sqrt(1+0.0004*9);
#X obj 20 260 osc~;
#X obj 130 260 osc~;
#X obj 240 260 osc~;
#X obj 350 260 osc~;
#X obj 460 260 osc~;
#X obj 570 260 osc~;
#X obj 680 260 osc~;
#X obj 790 260 osc~;
#X obj 900 260 osc~;
#X obj 500 150 expr 1 \; 0.5*(0.45+0.55*\$f1/127) \; 0.333*pow(0.45+0.55*\$f1/127 \, 2) \; 0.25*pow(0.45+0.55*\$f1/127 \, 3) \; 0.2*pow(0.45+0.55*\$f1/127 \, 4) \; 0.167*pow(0.45+0.55*\$f1/127 \, 5) \; 0.8 \; 0.4*(0.45+0.55*\$f1/127) \; 0.27*pow(0.45+0.55*\$f1/127 \, 2);
#X obj 20 300 *~ 0;
#X obj 130 300 *~ 0;
