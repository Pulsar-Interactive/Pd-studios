#X msg 1000 220 0 \, \$1 1 \, 0 30 1;
#X obj 1000 190 expr 0.25*\$f1/127;
#X obj 500 470 *~ 0;
#X obj 500 230 expr 0.14*pow(\$f1/127 \, 1.5);
