#N canvas 40 40 700 380 12;
#X text 20 5 [atom-sq-kv FIELD KNOB LABEL VAR MUL VIEW] - a knob label and its value on one screen field \, e.g. 1 VOL 50. written on sq-page-redraw and sq-knob-redraw while view VIEW is open (view = page*10 + sub-page). value = int(VAR * MUL);
#X obj 20 50 r sq-page-redraw;
#X obj 160 50 r sq-knob-redraw;
#X obj 20 80 t b;
#X obj 20 110 expr sqview==\$6;
#X obj 20 140 sel 1;
#X obj 20 170 v \$4;
#X obj 20 200 * \$5;
#X obj 20 230 i;
#X obj 20 260 makefilename %d;
#X obj 20 290 list fromsymbol;
#X obj 20 320 list prepend;
#X obj 20 350 atom-sq-text \$1 127 127 0;
#X obj 300 50 loadbang;
#X obj 300 80 t b b;
#X obj 400 110 f \$2;
#X obj 400 140 + 48;
#X obj 400 170 list append 32;
#X obj 300 200 list prepend;
#X obj 300 110 symbol \$3;
#X obj 300 140 list fromsymbol;
#X obj 300 230 list append 32;
#X connect 1 0 3 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 13 0 14 0;
#X connect 14 1 15 0;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 17 0 18 1;
#X connect 14 0 19 0;
#X connect 19 0 20 0;
#X connect 20 0 18 0;
#X connect 18 0 21 0;
#X connect 21 0 11 1;
