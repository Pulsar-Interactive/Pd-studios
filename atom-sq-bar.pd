#N canvas 40 40 620 300 12;
#X text 20 5 [atom-sq-bar FIELD R G B LABEL] - a text meter: LABEL then one | per step (0-8). only writes when the value changes;
#X obj 20 50 inlet;
#X obj 20 80 change;
#X obj 20 110 t b f;
#X msg 20 140 124 124 124 124 124 124 124 124;
#X obj 20 170 list split;
#X obj 20 200 list prepend;
#X obj 20 230 atom-sq-text \$1 \$2 \$3 \$4;
#X obj 320 50 r sq-page-redraw;
#X msg 320 80 set -1;
#X obj 420 50 loadbang;
#X obj 420 80 symbol \$5;
#X obj 420 110 list fromsymbol;
#X obj 420 140 list append 32;
