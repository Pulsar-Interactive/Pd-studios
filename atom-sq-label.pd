#N canvas 40 40 700 360 12;
#X text 20 5 [atom-sq-label FIELD VIEW TEXT VAR VALUE] - a screen-button label on one screen field while view VIEW is open (page*10 + sub-page): bright when VAR == VALUE (the active choice) \, dim otherwise. written on sq-page-redraw;
#X obj 20 50 r sq-page-redraw;
#X obj 20 80 t b;
#X obj 20 110 expr sqview==\$2;
#X obj 20 140 sel 1;
#X obj 20 170 t b b;
#X obj 160 200 v \$4;
#X obj 160 230 == \$5;
#X obj 160 260 sel 1 0;
#X msg 160 290 127 127 127;
#X msg 280 290 35 35 35;
#X obj 20 290 list append;
#X obj 20 330 atom-sq-text \$1 127 127 127;
#X obj 400 50 loadbang;
#X obj 400 80 symbol \$3;
#X obj 400 110 list fromsymbol;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 1 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 8 1 10 0;
#X connect 9 0 12 1;
#X connect 10 0 12 1;
#X connect 5 0 11 0;
#X connect 11 0 12 0;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
#X connect 15 0 11 1;
