#N canvas 40 40 1000 520 12;
#X text 20 5 [atom-sq-eq] - the two 3-band EQs. sq-do-seq-low / mid / high: synth EQ steps in dB (-24 to +6 \, sent as sq-eq-low/mid/high to atom-sq-synth). sq-do-meq-low / mid / high: music EQ steps \, sent over UDP to separate-speakers.pd on localhost 9030. the PLAY and MUSIC pages send these. loaded by atom-sq-map;
#X obj 600 60 loadbang;
#X msg 600 90 connect localhost 9030 \, send low 0 \, send mid 0 \, send high 0;
#X obj 600 130 netsend -u;
#X obj 800 130 s sq-knob-redraw;
#X obj 20 170 r sq-do-seq-low;
#X obj 20 200 expr max(-24 \, min(6 \, sqslow+\$f1));
#X obj 20 230 v sqslow;
#X obj 20 260 s sq-eq-low;
#X obj 20 320 r sq-do-meq-low;
#X obj 20 350 expr max(-24 \, min(6 \, sqmlow+\$f1));
#X obj 20 380 v sqmlow;
#X obj 20 410 list prepend send low;
#X obj 20 440 list trim;
#X obj 340 170 r sq-do-seq-mid;
#X obj 340 200 expr max(-24 \, min(6 \, sqsmid+\$f1));
#X obj 340 230 v sqsmid;
#X obj 340 260 s sq-eq-mid;
#X obj 340 320 r sq-do-meq-mid;
#X obj 340 350 expr max(-24 \, min(6 \, sqmmid+\$f1));
#X obj 340 380 v sqmmid;
#X obj 340 410 list prepend send mid;
#X obj 340 440 list trim;
#X obj 660 170 r sq-do-seq-high;
#X obj 660 200 expr max(-24 \, min(6 \, sqshigh+\$f1));
#X obj 660 230 v sqshigh;
#X obj 660 260 s sq-eq-high;
#X obj 660 320 r sq-do-meq-high;
#X obj 660 350 expr max(-24 \, min(6 \, sqmhigh+\$f1));
#X obj 660 380 v sqmhigh;
#X obj 660 410 list prepend send high;
#X obj 660 440 list trim;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 6 0 8 0;
#X connect 6 0 4 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 10 0 12 0;
#X connect 12 0 13 0;
#X connect 13 0 3 0;
#X connect 10 0 4 0;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
#X connect 15 0 17 0;
#X connect 15 0 4 0;
#X connect 18 0 19 0;
#X connect 19 0 20 0;
#X connect 19 0 21 0;
#X connect 21 0 22 0;
#X connect 22 0 3 0;
#X connect 19 0 4 0;
#X connect 23 0 24 0;
#X connect 24 0 25 0;
#X connect 24 0 26 0;
#X connect 24 0 4 0;
#X connect 27 0 28 0;
