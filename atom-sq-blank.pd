#X obj 20 140 sel 1;
#X msg 20 170 32;
#X obj 20 200 atom-sq-text \$1 127 127 127;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
