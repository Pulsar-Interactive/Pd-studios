#X obj 620 208 trim-ctl;
#X obj 620 252 hsl 162 19 0 2 0 0 empty empty SUB-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 810 252 tgl 19 0 empty empty SUB-mute 22 8 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 620 288 trim-ctl;
#X obj 620 340 midi-learn;
#X obj 810 340 tgl 19 0 empty empty learn-SUB 22 8 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 620 376 * 2;
#X obj 620 420 midi-learn;
#X obj 810 420 tgl 19 0 empty empty learn-XOVER 22 8 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 620 456 expr 60*pow(3.33333 \, $f1);
#X text 200 45 Music L/R read straight off the aggregate device;
#X text 180 140 MAIN L - ch 1;
#X text 420 140 MAIN R - ch 2;
#X text 130 325 SUB \, mono - ch 3;
#X text 147 227 L low + R low summed \, x0.5 so the mono sum stays at unity instead of +6 dB;
#X text 335 250 MAINS meter;
#X text 185 370 SUB meter;
#X text 198 474 vu is fed env~ minus 100 \, the standard Pd idiom. Its red zone is your clip warning -- the trims reach 2 \, which is +6 dB \, so this is easy to hit.;
#X text 855 191 With only two bands \, the two mutes give you solo for free: mute the mains to solo the sub \, which is how you check the crossover point by ear.;
#X text 859 365 To bind a knob: tick learn \, move the knob \, untick. It binds that CC only and ignores every other control.;
#X text 686 488 Output map \, now the only one in the repo: mains on ch 1/2 \, mono sub on ch 3 Low-Hit-Balancer.pd was a duplicate of this patch that claimed ch 3 for its tops \; it was deleted rather than reconciled.;
#X text 619 550 Trims MUST init: the *~ right inlets are signals \, so an unset line~ outputs 0 = silence. The loadbang above is load-bearing.;
#X msg 42 588 connect localhost 34000;
#X msg 295 546 disconnect;
#X obj 40 540 netsend -u;
#X obj 175 540 tgl 19 0 empty empty empty 0 -10 0 12 #dfdfdf #000000 #000000 0 1;
#X obj 215 540 print;
#X text 40 478 blackhole-server;
#X msg 474 383 send mains \$1;
#X msg 39 394 send sub \$1;
#X text 241 621 env~ is dB 0-100 \, tapped before the -100 the vu needs. Mains = high band \, sub = low band.;
#X obj 40 75 eq3;
#X obj 300 75 eq3;
#X obj 900 25 netreceive -u 9030;
#X obj 900 58 route low mid high;
#X text 1000 25 music EQ from the ATOM SQ (hold SHIFT + encoders 3-5 \, see atom-sq-eq.pd). low \, mid \, high in dB \, flat until it sends;
