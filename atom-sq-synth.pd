#X obj 220 100 r sq-do-vol;
#X obj 220 130 expr max(0 \, min(1 \, sqvol+\$f1*0.01));
#X obj 220 160 v sqvol;
#X msg 300 100 0.5;
#X obj 220 190 * 0.3;
#X obj 220 220 pack f 20;
#X obj 220 250 line~;
#X obj 420 100 r sq-do-tone;
#X obj 420 130 expr max(0 \, min(1 \, sqcut+\$f1*0.01));
#X obj 420 160 v sqcut;
#X msg 500 100 1;
#X obj 420 190 expr 200*pow(60 \, \$f1);
#X obj 320 160 s sq-knob-redraw;
#X obj 220 300 r sq-ready;
#X obj 220 330 expr sqvol;
#X obj 320 330 expr sqcut;
#X obj 220 390 s sq-vol;
#X obj 420 220 s sq-cut;
#X obj 220 360 * 100;
#X text 600 300 autoplay: Debussy \, Clair de Lune (Suite bergamasque \, L75). clair-de-lune.txt is clair-de-lune.mid as a qlist (delay ms \, sq-auto note velocity). MIDI from the Mutopia Project (piece 1778 \, Fromont 1905 edition \, LilyPond 2.12.3) \, public domain (CC no rights reserved);
#X obj 600 360 r sq-auto;
#X obj 600 375 t a a;
#X obj 700 390 unpack f f f;
#X obj 700 420 expr !sqprac || (sqhandp!=2 && \$f1!=sqhandp);
#X obj 600 450 spigot 1;
#X obj 600 560 qlist;
#X obj 600 420 loadbang;
#X msg 600 450 read clair-de-lune.txt;
#X obj 700 620 delay;
#X text 600 700 play engine: the qlist is stepped with next \, timed by this [delay] (speed = tempo F permsec \, pause = tempo 1e-20 permsec \, which keeps the place). sqpos = score time of the last line played (ms at 100 %) \, sqnext = time of the line waited for \, sqtotal = song length (scanned at load with next 1). the big dial seeks 5 s per click and the touch strip jumps to where you touch it (left = start \, right = end) \, both while playing or paused;
#X obj 600 760 v sqrun;
#X obj 690 760 v sqpos;
