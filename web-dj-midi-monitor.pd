#N canvas 100 100 500 500 10;
#X obj 20 60 notein;
#X obj 20 200 ctlin;
#X obj 20 320 bendin;
#X obj 20 400 pgmin;
#X obj 20 120 print note-pitch;
#X obj 150 120 print note-vel;
#X obj 280 120 print note-chan;
#X obj 20 260 print ctl-value;
#X obj 150 260 print ctl-num;
#X obj 280 260 print ctl-chan;
#X obj 20 360 print bend-val;
#X obj 150 360 print bend-chan;
#X obj 20 440 print pgm-val;
#X obj 150 440 print pgm-chan;
#X text 20 10 WEB DJ MIDI monitor -- move each pad/knob/fader/jog and read the numbers below;
#X connect 0 0 4 0;
#X connect 0 1 5 0;
#X connect 0 2 6 0;
#X connect 1 0 7 0;
#X connect 1 1 8 0;
#X connect 1 2 9 0;
#X connect 2 0 10 0;
#X connect 2 1 11 0;
#X connect 3 0 12 0;
#X connect 3 1 13 0;
